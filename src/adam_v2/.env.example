# ADAM v2.0 Configuration

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/adam_v2.db

# LLM Configuration
# OpenAI
OPENAI_API_KEY=your-openai-api-key

# xAI (Grok)
XAI_API_KEY=your-xai-api-key

# Default model (optional)
DEFAULT_MODEL=grok-3-mini-high

# Memory settings
MEMORY_SEARCH_ENABLED=true
MEMORY_SEARCH_LIMIT=5

# Development settings
DEBUG=true
RELOAD=true