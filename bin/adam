#!/bin/bash
# ADAM Global Command - Analytics Data Assistant with Memory
# Works from anywhere, just like Claude Code

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Set ADAM root directory
ADAM_ROOT="/Users/vitoryago/ADAM"

# Function to show help
show_help() {
    echo -e "${BLUE}ADAM - Analytics Data Assistant with Memory${NC}"
    echo ""
    echo "Usage: adam [options] [message]"
    echo ""
    echo "Options:"
    echo "  -h, --help     Show this help message"
    echo "  -c, --chat     Launch interactive chat mode (default)"
    echo "  -v, --version  Show version information"
    echo "  -r, --react    Open React web interface in browser"
    echo ""
    echo "Examples:"
    echo "  adam                    # Start interactive chat"
    echo "  adam --react            # Open React web interface"
    echo "  adam \"Hello ADAM\"       # Send a single message"
    echo ""
    echo "Just like Claude Code, ADAM provides AI assistance with perfect memory!"
}

# Check which Python to use (prefer conda if available)
if command -v /opt/anaconda3/bin/python &> /dev/null; then
    PYTHON_CMD="/opt/anaconda3/bin/python"
elif command -v python3 &> /dev/null; then
    PYTHON_CMD="python3"
else
    PYTHON_CMD="python"
fi

# Parse arguments
case "$1" in
    -h|--help)
        show_help
        exit 0
        ;;
    -v|--version)
        echo -e "${GREEN}ADAM v2.0.0${NC}"
        echo "Analytics Data Assistant with Memory"
        exit 0
        ;;
    -r|--react)
        echo -e "${BLUE}Opening ADAM React Interface...${NC}"
        
        # Check if backend is running
        if ! curl -s http://localhost:8000/api/health > /dev/null 2>&1; then
            echo -e "${YELLOW}Starting ADAM backend...${NC}"
            cd "$ADAM_ROOT/src/adam_v2"
            python main.py > "$ADAM_ROOT/backend.log" 2>&1 &
            sleep 3
        else
            echo -e "${GREEN}✓ Backend is running${NC}"
        fi
        
        # Check if React dev server is running
        if ! curl -s http://localhost:5173 > /dev/null 2>&1; then
            echo -e "${YELLOW}Starting React development server...${NC}"
            cd "$ADAM_ROOT/frontend/AdamChat"
            npm run dev > "$ADAM_ROOT/frontend.log" 2>&1 &
            sleep 5
        else
            echo -e "${GREEN}✓ React dev server is running${NC}"
        fi
        
        # Open React frontend in browser
        open "http://localhost:5173" 2>/dev/null || xdg-open "http://localhost:5173" 2>/dev/null
        echo -e "${GREEN}✓ ADAM React interface opened in browser${NC}"
        echo -e "${BLUE}Backend API: http://localhost:8000/api/docs${NC}"
        echo -e "${BLUE}React Frontend: http://localhost:5173${NC}"
        exit 0
        ;;
    -c|--chat|"")
        # Interactive chat mode with tools (default)
        echo -e "${BLUE}Starting ADAM with Full Tool Support...${NC}"
        echo -e "${YELLOW}(Press Ctrl+C to exit)${NC}"
        echo ""
        cd "$ADAM_ROOT"
        
        # Use the Claude-style natural language CLI
        if [ -f "$ADAM_ROOT/cli/adam_claude_style.py" ]; then
            exec $PYTHON_CMD "$ADAM_ROOT/cli/adam_claude_style.py"
        elif [ -f "$ADAM_ROOT/cli/adam_with_tools.py" ]; then
            exec $PYTHON_CMD "$ADAM_ROOT/cli/adam_with_tools.py"
        else
            exec $PYTHON_CMD "$ADAM_ROOT/cli/adam_chat.py"
        fi
        ;;
    *)
        # Single message mode
        cd "$ADAM_ROOT"
        echo "$@" | $PYTHON_CMD "$ADAM_ROOT/cli/adam_chat.py"
        ;;
esac