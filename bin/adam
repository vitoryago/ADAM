#!/bin/bash
# ADAM - Analytics Data Assistant with Memory

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Set ADAM root directory
ADAM_ROOT="/Users/vitoryago/ADAM"

# Function to show help
show_help() {
    echo -e "${BLUE}ADAM - Analytics Data Assistant with Memory${NC}"
    echo ""
    echo "Usage: adam [options]"
    echo ""
    echo "Options:"
    echo "  --web          Launch web interface (React + Backend)"
    echo "  --help         Show this help message"
    echo "  --version      Show version information"
    echo ""
    echo "For IDE integration, use the ADAM VSCode extension."
    echo "It's already installed and available in all VSCode sessions!"
}

# Check which Python to use (prefer conda if available)
if command -v /opt/anaconda3/bin/python &> /dev/null; then
    PYTHON_CMD="/opt/anaconda3/bin/python"
elif command -v python3 &> /dev/null; then
    PYTHON_CMD="python3"
else
    PYTHON_CMD="python"
fi

# Parse arguments
case "$1" in
    --help)
        show_help
        exit 0
        ;;
    --version)
        echo -e "${GREEN}ADAM v2.0.0${NC}"
        echo "Analytics Data Assistant with Memory"
        exit 0
        ;;
    --web)
        echo -e "${BLUE}🚀 Launching ADAM Web Interface...${NC}"
        echo ""
        
        # Check if backend is running
        if ! curl -s http://localhost:8000/api/health > /dev/null 2>&1; then
            echo -e "${YELLOW}⏳ Starting ADAM backend...${NC}"
            cd "$ADAM_ROOT/src/adam_v2"
            $PYTHON_CMD main.py > "$ADAM_ROOT/backend.log" 2>&1 &
            BACKEND_PID=$!
            
            # Wait for backend to be ready
            for i in {1..10}; do
                if curl -s http://localhost:8000/api/health > /dev/null 2>&1; then
                    echo -e "${GREEN}✅ Backend started successfully${NC}"
                    break
                fi
                sleep 1
            done
        else
            echo -e "${GREEN}✅ Backend is already running${NC}"
        fi
        
        # Check if React dev server is running
        if ! curl -s http://localhost:5173 > /dev/null 2>&1; then
            echo -e "${YELLOW}⏳ Starting React frontend...${NC}"
            cd "$ADAM_ROOT/frontend/AdamChat"
            npm run dev > "$ADAM_ROOT/frontend.log" 2>&1 &
            FRONTEND_PID=$!
            
            # Wait for frontend to be ready
            for i in {1..10}; do
                if curl -s http://localhost:5173 > /dev/null 2>&1; then
                    echo -e "${GREEN}✅ Frontend started successfully${NC}"
                    break
                fi
                sleep 1
            done
        else
            echo -e "${GREEN}✅ Frontend is already running${NC}"
        fi
        
        # Open browser
        echo ""
        echo -e "${BLUE}📊 Opening ADAM in your browser...${NC}"
        sleep 1
        open "http://localhost:5173" 2>/dev/null || xdg-open "http://localhost:5173" 2>/dev/null
        
        echo ""
        echo -e "${GREEN}🎉 ADAM Web Interface is ready!${NC}"
        echo -e "${BLUE}   Frontend: http://localhost:5173${NC}"
        echo -e "${BLUE}   Backend API: http://localhost:8000/api/docs${NC}"
        echo ""
        echo -e "${YELLOW}Press Ctrl+C to stop the servers${NC}"
        
        # Keep running and handle Ctrl+C
        trap "echo -e '\n${YELLOW}Shutting down...${NC}'; kill $BACKEND_PID $FRONTEND_PID 2>/dev/null; exit" INT
        wait
        ;;
    *)
        show_help
        exit 0
        ;;
esac