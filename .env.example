# ADAM Environment Variables
# Copy this file to .env and fill in your actual API keys

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# X.AI API Configuration (for Grok models)
XAI_API_KEY=your_xai_api_key_here

# Optional: Embedding Model Configuration
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2

# Optional: Voice Configuration
ENABLE_VOICE=true
VOICE_SPEED=150

# Optional: Memory Storage Path
MEMORY_STORAGE_PATH=./adam_memory_advanced

# Optional: Conversation Storage Path
CONVERSATION_STORAGE_PATH=./conversations

# Cost Limits (in USD)
DAILY_COST_LIMIT=1.00
MONTHLY_COST_LIMIT=30.00

# Model Selection Preferences
# Options: grok-3-mini-reasoning-high, o3, claude-opus-4
DEFAULT_SIMPLE_MODEL=grok-3-mini-reasoning-high
DEFAULT_COMPLEX_MODEL=o3
DEFAULT_CODING_MODEL=claude-opus-4

# Pricing API Configuration (for real-time pricing)
ENABLE_DYNAMIC_PRICING=true
PRICING_CACHE_HOURS=24

# Memory Confidence Thresholds
MEMORY_CONFIDENCE_THRESHOLD=0.7
MEMORY_HIGH_CONFIDENCE_THRESHOLD=0.9

# Logging Level
LOG_LEVEL=INFO