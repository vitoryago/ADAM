# ADAM Configuration Template
# Copy this to .env and fill in your API keys

# API Keys (get these from respective providers)
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here  
XAI_API_KEY=your_xai_key_here

# Model Configuration
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
DEFAULT_SIMPLE_MODEL=grok-3-mini-fast
DEFAULT_COMPLEX_MODEL=grok-4-reasoning
DEFAULT_CODING_MODEL=grok-4

# Storage Paths
MEMORY_STORAGE_PATH=./data/adam_memory
PROJECT_STORAGE_PATH=./data/adam_projects
CONVERSATION_STORAGE_PATH=./data/conversations

# Cost Limits (in USD)
DAILY_COST_LIMIT=1.00
MONTHLY_COST_LIMIT=30.00

# Memory Configuration
MEMORY_CONFIDENCE_THRESHOLD=0.7
MEMORY_HIGH_CONFIDENCE_THRESHOLD=0.9

# Screen Capture (optional coworker features)
ENABLE_SCREEN_CAPTURE=false
SCREEN_MONITOR_INTERVAL=30

# Voice Settings (optional)
ENABLE_VOICE=false
VOICE_SPEED=150

# Logging
LOG_LEVEL=INFO