# ADAM Configuration
ADAM_NAME=ADAM
ADAM_LANGUAGE=en  # Default language (en, pt, es)
ADAM_VOICE_SPEED=180
ADAM_VOICE_ENGINE=pyttsx3  # or 'elevenlabs' for premium

# Optional API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_key_here  # For Claude
ELEVENLABS_API_KEY=your_key_here  # For premium voices

# xAI API Key for Grok models
XAI_API_KEY=your_xai_api_key_here

# Database Connections (Examples)
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_PASSWORD=
# POSTGRES_CONNECTION_STRING=

# Paths
DBT_PROJECT_PATH=
KNOWLEDGE_BASE_PATH=./knowledge
LOG_LEVEL=INFO

# ADAM Embedding Model Configuration
# Options: all-MiniLM-L6-v2, all-mpnet-base-v2, all-MiniLM-L12-v2
# OpenAI options (requires API key): text-embedding-3-small, text-embedding-3-large, text-embedding-ada-002
ADAM_EMBEDDING_MODEL=all-mpnet-base-v2
